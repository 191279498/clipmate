    {
      "matches": [
        "https://www.douyin.com/*",
        "https://v.douyin.com/*"
      ],
      "js": [
        "src/content/douyin-net-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
